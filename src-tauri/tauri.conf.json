{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemDock",
  "version": "0.1.13",
  "identifier": "dev.memdock.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MemDock",
        "minWidth": 1024,
        "minHeight": 640,
        "width": 1180,
        "height": 740,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCOTMzMTUwQjFBMjczNUQKUldSZGM2S3hVREdURzFydUM4YWRuNEJLaXRPMWlMSERrY2hTb2IydTJMZHF2YTRVTXJqeVRMTXYK",
      "endpoints": [
        "https://github.com/LingyiChen-AI/MemDock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
